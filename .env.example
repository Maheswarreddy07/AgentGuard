# Database. SQLite for local dev; PostgreSQL for production, e.g. postgresql+psycopg://user:pass@db:5432/agentguard
DATABASE_URL=sqlite:///./agentguard.db
# Optional LLM provider for AI-assisted diagnosis (NOT required; deterministic engine works without it)
LLM_PROVIDER=
LLM_API_KEY=
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173
# AI diagnosis (optional): provider must be "anthropic"; model name is required
LLM_MODEL=
# Abuse protection: requests per minute per client IP (0 disables)
RATE_LIMIT_PER_MIN=600
# Delete traces older than N days at startup (0 disables)
RETENTION_DAYS=0
# Set to 0 in production and run `alembic upgrade head` instead
AUTO_CREATE_TABLES=1

# ---- Authentication ----
# Sign-in is ON by default. Set to 0 only on your own machine.
AUTH_REQUIRED=1
# Optional: create the first admin automatically (otherwise the browser shows a first-run setup screen)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_HOURS=12
AUTH_MIN_PASSWORD=10
AUTH_MAX_FAILURES=5
AUTH_LOCK_MINUTES=15
# Address shown in the "Connect an agent" snippet (defaults to the address the browser used)
PUBLIC_API_URL=
