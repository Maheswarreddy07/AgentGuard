# Copy to .env and fill in. Nothing here is a secret until you put one in.
DATABASE_URL=sqlite:///./agentguard.db        # production: postgresql+psycopg://user:password@host:5432/agentguard
AUTH_REQUIRED=1                               # never set to 0 outside your own laptop
AUTO_CREATE_TABLES=1                          # production: 0, and run `alembic upgrade head`
CORS_ORIGINS=http://localhost:5173            # the address people open in the browser (comma-separated)
PUBLIC_API_URL=http://localhost:8000          # the address agents use to reach the API (used in the downloadable starter file)
# ADMIN_EMAIL=you@example.com                 # optional: create the first admin without the setup screen
# ADMIN_PASSWORD=choose-a-long-password
